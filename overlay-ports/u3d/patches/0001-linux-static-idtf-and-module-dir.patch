diff --git a/RTL/Platform/Lin32/Common/IFXOSFileIterator.cpp b/RTL/Platform/Lin32/Common/IFXOSFileIterator.cpp
index d655abf..8e207f1 100644
--- a/RTL/Platform/Lin32/Common/IFXOSFileIterator.cpp
+++ b/RTL/Platform/Lin32/Common/IFXOSFileIterator.cpp
@@ -48,6 +48,25 @@
 #define IFXOSFI_SUBDIR  L"Plugins"
 #define IFXOSFI_EXT L".so"
 
+
+// patch: when U3D_LIBDIR is not set, use the directory of the running executable as the module directory
+// (the IFX core library and its Plugins/ folder are shipped next to the application).
+#include <unistd.h>
+#include <limits.h>
+#include <string.h>
+static const char* ifxExecutableDir()
+{
+    static char dir[PATH_MAX] = {0};
+    if (!dir[0])
+    {
+        ssize_t n = readlink("/proc/self/exe", dir, sizeof(dir) - 1);
+        if (n <= 0) { strcpy(dir, "."); return dir; }
+        dir[n] = 0;
+        char* slash = strrchr(dir, '/');
+        if (slash) *slash = 0; else strcpy(dir, ".");
+    }
+    return dir;
+}
 static const char* s_pDefaultCorePath = U3DCorePath;
 static const char* s_pCorePathEnvVar = "U3D_LIBDIR";
 
@@ -177,7 +196,7 @@ IFXRESULT IFXOSFileIterator::OpenIterator(const IFXCHAR *filesPath)
     // we use an environment variable for the lib directory: U3D_LIBDIR
     const char *lib = getenv(s_pCorePathEnvVar);
     if (lib == 0)
-		lib = s_pDefaultCorePath;
+		lib = ifxExecutableDir();
 		
     strncpy(pluginLocation, lib, IFXOSFI_MAXPATHLEN);
     pluginLocation[IFXOSFI_MAXPATHLEN-1] = 0;
