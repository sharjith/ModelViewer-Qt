<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Pdf3DExportDialog</class>
 <widget class="QDialog" name="Pdf3DExportDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>520</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Save as 3D PDF</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="sheetTab">
      <attribute name="title">
       <string>Sheet</string>
      </attribute>
      <layout class="QVBoxLayout" name="sheetLayout">
       <item>
        <widget class="QLabel" name="introLabel">
         <property name="text">
          <string>These fields fill the title block of the sheet. Empty fields stay blank.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QFormLayout" name="formLayout">
         <item row="0" column="0">
          <widget class="QLabel" name="titleLabel">
           <property name="text">
            <string>Title:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="titleEdit"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="drawingNumberLabel">
           <property name="text">
            <string>Drawing number:</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QLineEdit" name="drawingNumberEdit"/>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="revisionLabel">
           <property name="text">
            <string>Revision:</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QLineEdit" name="revisionEdit"/>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="authorLabel">
           <property name="text">
            <string>Author:</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QLineEdit" name="authorEdit"/>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="companyLabel">
           <property name="text">
            <string>Company:</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QLineEdit" name="companyEdit"/>
         </item>
         <item row="5" column="0">
          <widget class="QLabel" name="scaleLabel">
           <property name="text">
            <string>Scale:</string>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="QLineEdit" name="scaleEdit">
           <property name="placeholderText">
            <string>e.g. 1:2 or NTS</string>
           </property>
          </widget>
         </item>
         <item row="6" column="0">
          <widget class="QLabel" name="notesLabel">
           <property name="text">
            <string>Notes:</string>
           </property>
          </widget>
         </item>
         <item row="6" column="1">
          <widget class="QPlainTextEdit" name="notesEdit">
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>110</height>
            </size>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCheckBox" name="partsListCheck">
         <property name="toolTip">
          <string>Adds sheet(s) after the 3D view with a table of the exported parts:
item number, part name, material and quantity.</string>
         </property>
         <property name="text">
          <string>Add a parts list sheet</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>0</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="viewsTab">
      <attribute name="title">
       <string>Views</string>
      </attribute>
      <layout class="QVBoxLayout" name="viewsLayout">
       <item>
        <widget class="QLabel" name="viewsIntroLabel">
         <property name="text">
          <string>Tick the views to put in the PDF's view list. The first ticked view is the one shown when the file opens.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QTreeWidget" name="viewsTree">
         <property name="rootIsDecorated">
          <bool>true</bool>
         </property>
         <property name="uniformRowHeights">
          <bool>true</bool>
         </property>
         <column>
          <property name="text">
           <string>View</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Note</string>
          </property>
         </column>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="viewsButtonsLayout">
         <item>
          <widget class="QPushButton" name="selectAllButton">
           <property name="text">
            <string>Select all</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="selectNoneButton">
           <property name="text">
            <string>Select none</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="viewsButtonsSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="viewsInfoLabel">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="overlayTab">
      <attribute name="title">
       <string>Measurements</string>
      </attribute>
      <layout class="QVBoxLayout" name="overlayLayout">
       <item>
        <widget class="QLabel" name="overlayIntroLabel">
         <property name="text">
          <string>Tick the measurements and annotations to add to the 3D model. They are written for the view they were made from and show in every view.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QTreeWidget" name="overlayTree">
         <property name="rootIsDecorated">
          <bool>true</bool>
         </property>
         <property name="uniformRowHeights">
          <bool>true</bool>
         </property>
         <column>
          <property name="text">
           <string>Item</string>
          </property>
         </column>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="overlayButtonsLayout">
         <item>
          <widget class="QPushButton" name="overlayAllButton">
           <property name="text">
            <string>Select all</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="overlayNoneButton">
           <property name="text">
            <string>Select none</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="overlayButtonsSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
