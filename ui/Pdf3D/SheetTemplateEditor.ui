         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="fieldsTab">
        <attribute name="title">
         <string>Fields</string>
        </attribute>
        <layout class="QVBoxLayout" name="fieldsTabLayout" stretch="0,1,0,0,0">
         <item>
          <widget class="QLabel" name="fieldsIntro">
           <property name="text">
            <string>Extra values the Save as 3D PDF dialog asks for. Use {id} in the text of a cell to print one.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QListWidget" name="fieldList">
           <property name="minimumSize">
            <size>
             <width>0</width>
             <height>90</height>
            </size>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="fieldButtonsLayout">
           <item>
            <widget class="QPushButton" name="fieldAdd">
             <property name="text">
              <string>Add</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="fieldDelete">
             <property name="text">
              <string>Delete</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="fieldUp">
             <property name="text">
              <string>Up</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="fieldDown">
             <property name="text">
              <string>Down</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QPushButton" name="fieldAddCell">
           <property name="toolTip">
            <string>Adds a cell that prints this field to the Cells tab, below the cell selected there. Drag it into place in the preview.</string>
           </property>
           <property name="text">
            <string>Add a cell for this field</string>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QFormLayout" name="fieldFormLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="fieldIdLabel">
             <property name="text">
              <string>Id:</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="fieldId">
             <property name="toolTip">
              <string>Letters, digits and underscores, starting with a letter. The names title, author, date ... are taken.
"material" and "mass" are filled from the model; a field with one of these names overrides them when it is not empty.</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="fieldLabelLabel">
             <property name="text">
              <string>Label:</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="fieldLabel"/>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="fieldTypeLabel">
             <property name="text">
              <string>Type:</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QComboBox" name="fieldType"/>
           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="fieldDefaultLabel">
             <property name="text">
              <string>Default value:</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QLineEdit" name="fieldDefault"/>
           </item>
           <item row="4" column="0">
            <widget class="QLabel" name="fieldOptionsLabel">
             <property name="text">
              <string>Choices:</string>
             </property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QPlainTextEdit" name="fieldOptions">
             <property name="maximumSize">
              <size>
               <width>16777215</width>
               <height>90</height>
              </size>
             </property>
             <property name="placeholderText">
              <string>One choice per line</string>
             </property>
            </widget>
           </item>
           <item row="5" column="0">
            <widget class="QLabel" name="fieldNumberLabel">
             <property name="text">
              <string>Number:</string>
             </property>
            </widget>
           </item>
           <item row="5" column="1">
            <layout class="QHBoxLayout" name="numberRowLayout">
             <item>
              <widget class="QLabel" name="decimalsLabel">
               <property name="text">
                <string>Decimals</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QSpinBox" name="fieldDecimals">
               <property name="toolTip">
                <string>Digits after the decimal separator when the number is printed.</string>
               </property>
               <property name="maximum">
                <number>6</number>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="unitLabel">
               <property name="text">
                <string>Unit</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLineEdit" name="fieldUnit">
               <property name="toolTip">
                <string>Printed after the number, for example kg.</string>
               </property>
               <property name="maxLength">
                <number>20</number>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="minLabel">
               <property name="text">
                <string>Min</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLineEdit" name="fieldMin">
               <property name="placeholderText">
                <string>no limit</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="maxLabel">
               <property name="text">
                <string>Max</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLineEdit" name="fieldMax">
               <property name="placeholderText">
                <string>no limit</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="errorLabel">
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <layout class="QHBoxLayout" name="buttonsLayout">
       <item>
        <spacer name="buttonsSpacer">
         <property name="orientation">
          <enum>Qt::Horizontal</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>40</width>
           <height>20</height>
          </size>
         </property>
        </spacer>
       </item>
       <item>
        <widget class="QPushButton" name="saveButton">
         <property name="text">
          <string>Save</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="saveAsButton">
         <property name="toolTip">
          <string>Saves the edited template as a new template of yours.</string>
         </property>
         <property name="text">
          <string>Save as...</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="cancelButton">
         <property name="text">
          <string>Cancel</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
