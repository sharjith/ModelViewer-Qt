<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SheetTemplateEditor</class>
 <widget class="QDialog" name="SheetTemplateEditor">
  <property name="windowTitle">
   <string>Edit sheet template</string>
  </property>
  <layout class="QHBoxLayout" name="outerLayout" stretch="5,3">
   <item>
    <layout class="QVBoxLayout" name="leftLayout" stretch="1,0">
     <item>
      <widget class="Pdf3D::SheetPreviewWidget" name="preview">
       <property name="minimumSize">
        <size>
         <width>420</width>
         <height>300</height>
        </size>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="hintLabel">
       <property name="text">
        <string>Click a cell in the sheet to select it. Drag it to move it, drag its edges or corners to resize it, or nudge it with the arrow keys (Shift for larger steps). Edges snap to the title block and to the other cells. The 3D area is shown grey.</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QVBoxLayout" name="rightLayout" stretch="0,1,0,0">
     <item>
      <layout class="QFormLayout" name="nameLayout">
       <item row="0" column="0">
