          <widget class="QLabel" name="labelRussianRouletteDepth">
           <property name="text">
            <string>Russian Roulette Start Depth</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QSpinBox" name="spinBoxRussianRouletteDepth">
           <property name="toolTip">
            <string>Bounce depth after which low-contribution paths start
being probabilistically terminated early, for speed</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>64</number>
           </property>
           <property name="value">
            <number>3</number>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="labelMaxShadowRayHits">
           <property name="text">
            <string>Max Shadow Ray Hits (CPU only)</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QSpinBox" name="spinBoxMaxShadowRayHits">
           <property name="toolTip">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Caps how many stacked transparent/glass surfaces a shadow ray walks through on the Embree (CPU) engine before giving up. &lt;/p&gt;&lt;p&gt;No effect on the OptiX (GPU) engine, which has no equivalent limit.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>32</number>
           </property>
           <property name="value">
            <number>8</number>
           </property>
          </widget>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="labelMaxVolumeScatterBounces">
           <property name="text">
            <string>Max Volume Scatter Bounces</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QSpinBox" name="spinBoxMaxVolumeScatterBounces">
           <property name="toolTip">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Caps how many free (no Russian roulette) scatter events KHR_materials_volume_scatter's subsurface-scattering random walk runs before it starts probabilistically terminating.&lt;/p&gt;&lt;p&gt;Lower this to trade SSS quality for render speed on volume-scatter-heavy scenes; has no effect on scenes without such materials.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>256</number>
           </property>
           <property name="value">
            <number>64</number>
           </property>
          </widget>
         </item>
        </layout>
