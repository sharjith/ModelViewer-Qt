   <item>
    <layout class="QFormLayout" name="fillParamsForm">
     <item row="0" column="0">
      <widget class="QLabel" name="patchDensityLabel">
       <property name="text">
        <string>Patch density:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QDoubleSpinBox" name="patchDensitySpin">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Controls how fine the new patch's triangulation is relative to the surrounding mesh (CGAL's triangulate_and_refine_hole density_control_factor) - larger values produce a denser patch. CGAL's own default is sqrt(2) &amp;#8776; 1.41.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="decimals">
        <number>2</number>
       </property>
       <property name="minimum">
        <double>1.000000000000000</double>
       </property>
       <property name="maximum">
        <double>5.000000000000000</double>
       </property>
       <property name="singleStep">
        <double>0.100000000000000</double>
       </property>
       <property name="value">
        <double>1.410000000000000</double>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="selfIntersectionStepsLabel">
       <property name="text">
        <string>Self-intersection resolution attempts:</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QSpinBox" name="selfIntersectionStepsSpin">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;How many smoothing/hole-refill rounds to try when resolving self-intersections (CGAL's remove_self_intersections number_of_iterations). CGAL's own default is 7.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="minimum">
        <number>1</number>
       </property>
       <property name="maximum">
        <number>50</number>
       </property>
       <property name="value">
        <number>7</number>
       </property>
      </widget>
     </item>
     <item row="2" column="0" colspan="2">
      <widget class="QCheckBox" name="trySmoothingCheckBox">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Also try a slower, smoothing-based repair strategy for self-intersections, in addition to the hole-filling-based strategy already tried by default. CGAL does not attempt this by default.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>Try smoothing-based resolution too</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QCheckBox" name="replacePreviousCheckBox">
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Undoably delete the previous Generate click's filled result(s) before running this one, so at most one filled result per source mesh accumulates in the scene.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="text">
      <string>Replace previous result</string>
     </property>
     <property name="checked">
      <bool>true</bool>
