   <item>
    <widget class="QListWidget" name="holesList">
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Every boundary loop found, including a genuinely open mesh's own outer edge - uncheck anything that is not an actual defect gap you want closed. Selecting a row highlights its loop (orange) in the viewport.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="selectionMode">
      <enum>QAbstractItemView::SelectionMode::SingleSelection</enum>
